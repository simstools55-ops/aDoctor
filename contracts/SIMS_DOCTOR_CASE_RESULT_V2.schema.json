{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SIMS_DOCTOR_CASE_RESULT_V2.schema.json",
  "title": "SIMS Article Doctor Case Result V2",
  "type": "object",
  "required": [
    "format",
    "contract_version",
    "case_id",
    "article_id",
    "diagnosis",
    "treatment_plan",
    "referral",
    "workflow",
    "reexamination"
  ],
  "properties": {
    "format": {
      "const": "SIMS_DOCTOR_CASE_RESULT_V2"
    },
    "contract_version": {
      "const": "2.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "diagnosis_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "medical_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "site_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "article_id": {
      "type": "string",
      "minLength": 1
    },
    "completed_at": {
      "type": "string"
    },
    "diagnosis": {
      "type": "object"
    },
    "treatment_plan": {
      "type": "object"
    },
    "referral": {
      "type": "object",
      "required": [
        "required",
        "destination",
        "allowed_scope",
        "blocked_scope"
      ]
    },
    "workflow": {
      "type": "object",
      "required": [
        "workflow_locked",
        "return_to"
      ],
      "properties": {
        "return_to": {
          "const": "SIMS_BLOG_MANAGER"
        }
      }
    },
    "reexamination": {
      "type": "object"
    },
    "presentation": {
      "type": "object",
      "required": [
        "standard",
        "summary",
        "do_now",
        "do_not",
        "next_step"
      ],
      "properties": {
        "standard": {
          "const": "SIMS_PRESENTATION_STANDARD_V1"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "do_now": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "do_not": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_step": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_after_days": {
          "type": [
            "integer",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "site_diagnosis_case_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "site_diagnosis_batch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "article_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "personal_knowledge_site_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "knowledge_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knowledge_candidate"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "knowledge_candidate": {
      "type": "object",
      "required": [
        "scope",
        "knowledge_type",
        "statement",
        "confidence",
        "source_product",
        "source_type"
      ],
      "properties": {
        "candidate_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "enum": [
            "OWNER",
            "SITE",
            "CROSS_SITE"
          ]
        },
        "site_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledge_type": {
          "type": "string"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_product": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confirmation_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "explicit_user_confirmation": {
          "type": "boolean"
        },
        "deterministic_state": {
          "type": "boolean"
        }
      }
    }
  }
}
