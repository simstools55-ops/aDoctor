{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sims.local/contracts/SIMS_DOCTOR_REFERRAL_V1.schema.json",
  "title": "SIMS_DOCTOR_REFERRAL_V1",
  "type": "object",
  "required": [
    "referral_id",
    "case_id",
    "medical_record_id",
    "diagnosis_id",
    "treatment_recommendation_id",
    "target",
    "priority",
    "article",
    "clinical_summary",
    "issued_at",
    "contract_version",
    "fingerprint"
  ],
  "properties": {
    "referral_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "medical_record_id": {
      "type": "string"
    },
    "diagnosis_id": {
      "type": "string"
    },
    "treatment_recommendation_id": {
      "type": "string"
    },
    "target": {
      "type": "string",
      "enum": [
        "WRITER",
        "CREATOR",
        "MERGE",
        "OBSERVATION",
        "NOINDEX_REVIEW",
        "DELETE_REVIEW"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "article": {
      "type": "object"
    },
    "clinical_summary": {
      "type": "object"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "contract_version": {
      "const": "1.0"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
