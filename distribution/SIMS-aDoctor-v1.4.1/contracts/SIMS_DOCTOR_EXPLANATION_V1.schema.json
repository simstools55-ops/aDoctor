{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sims.local/contracts/SIMS_DOCTOR_EXPLANATION_V1.schema.json",
  "title": "SIMS_DOCTOR_EXPLANATION_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "explanation_id",
    "case_id",
    "medical_record_id",
    "created_at",
    "audience",
    "final_diagnosis",
    "summary",
    "decision_path",
    "supporting_factors",
    "blocking_factors",
    "trace"
  ],
  "properties": {
    "contract_name": {
      "const": "SIMS_DOCTOR_EXPLANATION_V1"
    },
    "contract_version": {
      "const": "1.0"
    },
    "explanation_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "medical_record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "audience": {
      "type": "string",
      "enum": [
        "USER",
        "SYSTEM"
      ]
    },
    "final_diagnosis": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "decision_path": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "supporting_factors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "blocking_factors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "trace": {
      "type": "object"
    }
  }
}
