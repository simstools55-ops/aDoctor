{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sims.local/schemas/SIMS_DOCTOR_ARTICLE_CATALOG_V1.schema.json",
  "title": "SIMS Article Doctor Article Catalog V1",
  "type": "object",
  "required": [
    "format",
    "contract_version",
    "schema_version",
    "source_system",
    "target_system",
    "message_id",
    "generated_at",
    "timezone",
    "site",
    "catalog",
    "articles"
  ],
  "properties": {
    "format": {
      "const": "SIMS_DOCTOR_ARTICLE_CATALOG_V1"
    },
    "contract_version": {
      "const": "1.0"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source_system": {
      "enum": [
        "SIMS_BLOG_MANAGER"
      ]
    },
    "target_system": {
      "enum": [
        "SIMS_DOCTOR"
      ]
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "const": "Asia/Tokyo"
    },
    "site": {
      "$ref": "#/$defs/site"
    },
    "catalog": {
      "type": "object",
      "required": [
        "catalog_id",
        "article_count",
        "is_full_snapshot"
      ],
      "properties": {
        "catalog_id": {
          "type": "string"
        },
        "article_count": {
          "type": "integer",
          "minimum": 0
        },
        "generated_from": {
          "type": "string"
        },
        "is_full_snapshot": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "article_id",
          "url",
          "title",
          "published_at",
          "article_status",
          "workflow_status",
          "diagnosis_control"
        ],
        "properties": {
          "article_id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "canonical_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "article_status": {
            "type": "string"
          },
          "workflow_status": {
            "type": "string"
          },
          "diagnosis_control": {
            "type": "object",
            "required": [
              "doctor_eligible"
            ],
            "properties": {
              "doctor_eligible": {
                "type": "boolean"
              },
              "exclusion_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "manual_hold": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "commonHeader": {
      "type": "object",
      "required": [
        "format",
        "contract_version",
        "schema_version",
        "source_system",
        "target_system",
        "message_id",
        "generated_at",
        "timezone"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "source_system": {
          "type": "string"
        },
        "target_system": {
          "type": "string"
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "const": "Asia/Tokyo"
        }
      }
    },
    "site": {
      "type": "object",
      "required": [
        "site_id",
        "site_name",
        "blog_url"
      ],
      "properties": {
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "site_name": {
          "type": "string",
          "minLength": 1
        },
        "blog_url": {
          "type": "string",
          "format": "uri"
        },
        "search_console_property": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}