      "position_max": 2.0,
      "expected_ctr": 0.15
    },
    {
      "position_max": 3.0,
      "expected_ctr": 0.1
    },
    {
      "position_max": 5.0,
      "expected_ctr": 0.06
    },
    {
      "position_max": 10.0,
      "expected_ctr": 0.03
    },
    {
      "position_max": 20.0,
      "expected_ctr": 0.015
    },
    {
      "position_max": 100.0,
      "expected_ctr": 0.005
    }
  ],
  "classifications": [
    "CTR_OPPORTUNITY",
    "HIGH_CTR_OPPORTUNITY",
    "WINNER_QUERY_PROTECTED",
    "RECENT_CHANGE_OBSERVATION",
    "HEALTHY_CTR",
    "INSUFFICIENT_DATA"
