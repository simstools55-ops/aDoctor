{
  "policy_name": "SIMS_DOCTOR_CTR_OPPORTUNITY_POLICY_V1",
  "version": "1.0",
  "thresholds": {
    "minimum_impressions": 200,
    "minimum_clicks": 1,
    "position_opportunity_min": 1.0,
    "position_opportunity_max": 10.0,
    "strong_position_max": 5.0,
    "ctr_gap_ratio": -0.25,
    "critical_ctr_gap_ratio": -0.5,
