{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sims.local/schemas/SIMS_DOCTOR_CASE_DIAGNOSIS_V1.schema.json",
  "title": "SIMS Article Doctor Case Diagnosis V1",
  "type": "object",
  "required": [
    "format",
    "contract_version",
    "schema_version",
    "source_system",
    "target_system",
    "message_id",
    "generated_at",
    "timezone",
    "site",
    "diagnosis_run",
    "cases",
    "summary"
  ],
  "properties": {
    "format": {
      "const": "SIMS_DOCTOR_CASE_DIAGNOSIS_V1"
    },
    "contract_version": {
      "const": "1.0"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source_system": {
      "enum": [
        "SIMS_DOCTOR"
      ]
    },
    "target_system": {
      "enum": [
        "SIMS_BLOG_MANAGER"
      ]
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "const": "Asia/Tokyo"
    },
    "site": {
      "$ref": "#/$defs/site"
    },
    "diagnosis_run": {
      "type": "object",
      "required": [
        "diagnosis_run_id",
        "snapshot_id",
        "catalog_id",
        "diagnosis_mode"
      ],
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "case_type",
          "status",
          "priority",
          "severity",
          "confidence",
          "diagnosis",
          "articles",
          "treatment_plan",
          "workflow_control",
          "decision"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "case_type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "WATCH"
            ]
          },
          "severity": {
            "enum": [
              "SEVERE",
              "MEDIUM",
              "MINOR",
              "INFORMATIONAL"
            ]
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW",
              "INSUFFICIENT"
            ]
          },
          "diagnosis": {
            "type": "object",
            "additionalProperties": true
          },
          "articles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "article_id",
                "url",
                "role"
              ],
              "additionalProperties": true
            }
          },
          "treatment_plan": {
            "type": "object",
            "required": [
              "recommended_treatment",
              "executor"
            ],
            "additionalProperties": true
          },
          "workflow_control": {
            "type": "object",
            "required": [
              "lock_required"
            ],
            "additionalProperties": true
          },
          "decision": {
            "type": "object",
            "required": [
              "decision_level"
            ],
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "commonHeader": {
      "type": "object",
      "required": [
        "format",
        "contract_version",
        "schema_version",
        "source_system",
        "target_system",
        "message_id",
        "generated_at",
        "timezone"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "source_system": {
          "type": "string"
        },
        "target_system": {
          "type": "string"
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "const": "Asia/Tokyo"
        }
      }
    },
    "site": {
      "type": "object",
      "required": [
        "site_id",
        "site_name",
        "blog_url"
      ],
      "properties": {
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "site_name": {
          "type": "string",
          "minLength": 1
        },
        "blog_url": {
          "type": "string",
          "format": "uri"
        },
        "search_console_property": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}