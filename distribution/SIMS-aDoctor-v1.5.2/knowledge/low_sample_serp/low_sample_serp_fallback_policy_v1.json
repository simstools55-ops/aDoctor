{
  "policy_name": "SIMS_ADOCTOR_LOW_SAMPLE_SERP_CLUSTER_FALLBACK_V1",
  "version": "1.1.0",
  "purpose": "When LOW_SAMPLE prevents outcome judgment, use target-query SERP diagnosis and, when the head SERP is structurally hard, evaluate site-level cluster opportunities before closing the case.",
  "activation": {
    "requires_low_sample": true,
    "normal_gsc_diagnosis_preferred_when_sufficient": true,
    "do_not_activate_for_clear_factual_error_only": true
  },
  "target_query": {
    "sources_in_priority": [
      "GSC_OBSERVED_QUERY_WHEN_RELIABLE",
      "SBM_STORED_TARGET_QUERY",
      "ARTICLE_TITLE_H1_BODY_INTENT_INFERENCE"
    ],
    "allow_unconfirmed_target": true,
    "confidence_levels": [
      "HIGH",
      "MEDIUM",
      "LOW",
      "UNCONFIRMED"
    ],
    "rule": "Never replace a stored target query solely because sparse GSC data shows another query."
  },
  "serp_review": {
    "web_search_required_when_available": true,
    "compare_top_results": true,
    "checks": [
      "SEARCH_INTENT_MATCH",
      "RESULT_TYPE_AND_SERP_STRUCTURE",
      "CONTENT_GAPS",
      "FACTUAL_SPECIFICITY",
      "FRESHNESS",
      "DECISION_SUPPORT",
      "UNIQUE_VALUE",
      "OFFICIAL_OR_HIGH_AUTHORITY_DOMINANCE"
    ],
    "prohibit_competitor_copying": true
  },
  "cluster_strategy": {
    "trigger": "HARD_SERP_WITHOUT_DIRECT_ACTIONABLE_GAP",
    "required_before_low_priority_close": true,
    "checks": [
      "EXISTING_RELATED_CONTENT_SUPPORT",
      "INTERNAL_LINK_SUPPORT",
      "INDEPENDENT_ADJACENT_SEARCH_INTENT",
      "SEARCH_DEMAND_SIGNAL",
      "SERP_ENTRY_ROOM",
      "CANNIBALIZATION_RISK",
      "NATURAL_LINK_TO_TARGET",
      "SITE_TOPIC_FIT",
      "EXPECTED_INVESTMENT_VALUE"
    ],
    "new_article_rules": [
      "ARTICLE_MUST_HAVE_INDEPENDENT_USER_VALUE",
      "ARTICLE_MUST_TARGET_DISTINCT_SEARCH_INTENT",
      "DO_NOT_CREATE_THIN_SATELLITE_CONTENT",
      "DO_NOT_CREATE_SOLELY_FOR_LINK_EQUITY",
      "VERIFY_CANNIBALIZATION_BEFORE_CREATOR_REFERRAL"
    ],
    "outcomes": [
      "EXISTING_CONTENT_SUPPORT",
      "CREATOR_OPPORTUNITY",
      "NO_CLUSTER_OPPORTUNITY"
    ]
  },
  "outcomes": [
    "SERP_GAP_ACTIONABLE",
    "SERP_COMPETITIVENESS_SUFFICIENT",
    "TARGET_QUERY_REASSESSMENT",
    "LOW_DEMAND_MAINTAIN",
    "ADDITIONAL_OBSERVATION",
    "CLUSTER_OPPORTUNITY_CHECK",
    "LOW_PRIORITY_SERP_STRUCTURE"
  ],
  "routing": {
    "SERP_GAP_ACTIONABLE": "RETURN_TO_SBM_FOR_SPECIALIST_REFERRAL",
    "SERP_COMPETITIVENESS_SUFFICIENT": "RETURN_TO_SBM_FOR_MONITORING",
    "TARGET_QUERY_REASSESSMENT": "RETURN_TO_SBM_FOR_MONITORING",
    "LOW_DEMAND_MAINTAIN": "RETURN_TO_SBM_AS_NORMAL_CLOSE",
    "ADDITIONAL_OBSERVATION": "RETURN_TO_SBM_FOR_MONITORING",
    "CLUSTER_OPPORTUNITY_CHECK": {
      "EXISTING_CONTENT_SUPPORT": "RETURN_TO_SBM_FOR_AWRITER_SUPPORT",
      "CREATOR_OPPORTUNITY": "RETURN_TO_SBM_FOR_ACREATOR_REFERRAL",
      "NO_CLUSTER_OPPORTUNITY": "RETURN_TO_SBM_AS_NORMAL_CLOSE"
    },
    "LOW_PRIORITY_SERP_STRUCTURE": "RETURN_TO_SBM_AS_NORMAL_CLOSE"
  },
  "workflow_consistency": {
    "LOW_PRIORITY_SERP_STRUCTURE": {
      "strategy": "MAINTAIN",
      "next_action": "CLOSE_MONITORING",
      "review_after_days": null
    },
    "LOW_DEMAND_MAINTAIN": {
      "strategy": "MAINTAIN",
      "next_action": "CLOSE_MONITORING",
      "review_after_days": null
    },
    "rule": "Do not emit WAIT/MONITOR together with a normal-close outcome. ADDITIONAL_OBSERVATION is the low-sample outcome that may extend monitoring."
  },
  "safety": {
    "low_sample_is_not_failure": true,
    "no_full_rewrite_from_low_sample_alone": true,
    "no_title_change_from_zero_clicks_alone": true,
    "current_serp_snapshot_not_personal_knowledge": true
  }
}
