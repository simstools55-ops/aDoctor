{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sims.local/contracts/SIMS_DOCTOR_BATCH_REQUEST_V1.schema.json",
  "title": "SIMS_DOCTOR_BATCH_REQUEST_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "batch_request_id",
    "requested_at",
    "site",
    "items"
  ],
  "properties": {
    "contract_name": {
      "const": "SIMS_DOCTOR_BATCH_REQUEST_V1"
    },
    "contract_version": {
      "const": "1.0"
    },
    "batch_request_id": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "site": {
      "type": "object",
      "required": [
        "site_id",
        "site_name",
        "site_url"
      ],
      "properties": {
        "site_id": {
          "type": "string"
        },
        "site_name": {
          "type": "string"
        },
        "site_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "article_id",
          "url",
          "title",
          "request_payload"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "article_id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "request_payload": {
            "type": "object"
          },
          "longitudinal_profile": {
            "type": [
              "object",
              "null"
            ]
          },
          "current_metrics": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  }
}
