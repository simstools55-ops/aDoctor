{
  "policy_name": "SIMS_ADOCTOR_LOW_SAMPLE_SERP_FALLBACK_V1",
  "version": "1.0.0",
  "purpose": "When GSC evidence is too sparse for outcome judgment, switch from passive waiting to target-query SERP competitiveness diagnosis without treating low sample as failure.",
  "activation": {
    "requires_low_sample": true,
    "normal_gsc_diagnosis_preferred_when_sufficient": true,
    "do_not_activate_for_clear_factual_error_only": true
  },
  "target_query": {
    "sources_in_priority": [
      "GSC_OBSERVED_QUERY_WHEN_RELIABLE",
      "SBM_STORED_TARGET_QUERY",
      "ARTICLE_TITLE_H1_BODY_INTENT_INFERENCE"
    ],
    "allow_unconfirmed_target": true,
    "confidence_levels": [
      "HIGH",
      "MEDIUM",
      "LOW",
      "UNCONFIRMED"
    ],
    "rule": "Never replace a stored target query solely because sparse GSC data shows another query."
  },
  "serp_review": {
    "web_search_required_when_available": true,
    "compare_top_results": true,
    "checks": [
      "SEARCH_INTENT_MATCH",
      "RESULT_TYPE_AND_SERP_STRUCTURE",
      "CONTENT_GAPS",
      "FACTUAL_SPECIFICITY",
      "FRESHNESS",
      "DECISION_SUPPORT",
      "UNIQUE_VALUE",
      "OFFICIAL_OR_HIGH_AUTHORITY_DOMINANCE"
    ],
    "prohibit_competitor_copying": true,
    "rule": "Recommend only gaps that improve usefulness for the target intent; do not imitate word count or headings mechanically."
  },
  "outcomes": [
    "SERP_GAP_ACTIONABLE",
    "SERP_COMPETITIVENESS_SUFFICIENT",
    "TARGET_QUERY_REASSESSMENT",
    "LOW_DEMAND_MAINTAIN",
    "ADDITIONAL_OBSERVATION",
    "LOW_PRIORITY_SERP_STRUCTURE"
  ],
  "routing": {
    "SERP_GAP_ACTIONABLE": "RETURN_TO_SBM_FOR_SPECIALIST_REFERRAL",
    "SERP_COMPETITIVENESS_SUFFICIENT": "RETURN_TO_SBM_FOR_MONITORING",
    "TARGET_QUERY_REASSESSMENT": "RETURN_TO_SBM_FOR_MONITORING",
    "LOW_DEMAND_MAINTAIN": "RETURN_TO_SBM_AS_NORMAL_CLOSE",
    "ADDITIONAL_OBSERVATION": "RETURN_TO_SBM_FOR_MONITORING",
    "LOW_PRIORITY_SERP_STRUCTURE": "RETURN_TO_SBM_AS_NORMAL_CLOSE"
  },
  "safety": {
    "low_sample_is_not_failure": true,
    "no_full_rewrite_from_low_sample_alone": true,
    "no_title_change_from_zero_clicks_alone": true,
    "low_demand_maintain_is_normal_completion": true,
    "current_serp_snapshot_not_personal_knowledge": true
  }
}
